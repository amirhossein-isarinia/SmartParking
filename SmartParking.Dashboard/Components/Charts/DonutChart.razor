@{
    int total = Slices.Sum(s => s.Count);
    const double r = 70, c = 2 * Math.PI * r;
    double offset = 0;
    int nonZero = Slices.Count(s => s.Count > 0);
}
<div class="donut">
    <div class="donut-ring">
        <svg viewBox="0 0 200 200" role="img" aria-label="@Label">
            <circle class="donut-track" cx="100" cy="100" r="@r" />
            @if (total > 0)
            {
                @foreach (var s in Slices.Where(s => s.Count > 0))
                {
                    double len = s.Count / (double)total * c;
                    double gap = nonZero > 1 ? 3 : 0;
                    <circle class="donut-seg @(_hover is not null && _hover != s.Key ? "is-dim" : "")" cx="100" cy="100" r="@r"
                            stroke="@s.Color"
                            stroke-dasharray="@F(Math.Max(0.5, len - gap)) @F(c)"
                            stroke-dashoffset="@F(-offset)"
                            transform="rotate(-90 100 100)"
                            @onmouseenter="() => _hover = s.Key" @onmouseleave="() => _hover = null">
                        <title>@s.Name: @Fa.Number(s.Count)</title>
                    </circle>
                    offset += len;
                }
            }
        </svg>
        <div class="donut-center">
            <strong>@Fa.Number(total)</strong>
            <small>@(total == 0 ? "بدون داده" : CenterLabel)</small>
        </div>
    </div>

    <ul class="legend">
        @foreach (var s in Slices)
        {
            <li class="@(_hover is not null && _hover != s.Key ? "is-dim" : "")" @onmouseenter="() => _hover = s.Key" @onmouseleave="() => _hover = null">
                <i style="background:@s.Color"></i>
                <span class="legend-name">@s.Name</span>
                <span class="legend-count">@Fa.Number(s.Count)</span>
                <span class="legend-pct">@(total == 0 ? "—" : Fa.Percent(s.Count * 100.0 / total))</span>
            </li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TypeSlice> Slices { get; set; } = Array.Empty<TypeSlice>();
    [Parameter] public string CenterLabel { get; set; } = "وسیله نقلیه";
    [Parameter] public string Label { get; set; } = "نمودار ترکیب وسایل نقلیه";

    private string? _hover;

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
