<div class="modal-layer @Class" @onclick="OnClose" @onkeydown="HandleKey" role="presentation">
    <div class="modal @SizeClass" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
        <div class="modal-head no-print">
            <h2>@Title</h2>
            <button type="button" class="icon-btn" aria-label="بستن" @onclick="OnClose"><Icon Name="x" Size="18" /></button>
        </div>
        <div class="modal-body">@ChildContent</div>
        @if (Footer is not null)
        {
            <div class="modal-foot no-print">@Footer</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Wide { get; set; }

    private string SizeClass => Wide ? "modal-wide" : string.Empty;

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await OnClose.InvokeAsync();
    }
}
