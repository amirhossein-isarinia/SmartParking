<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SmartParking</RootNamespace>
  </PropertyGroup>

  <!-- داشبورد (SmartParking.Dashboard) یک پروژه مستقل است و نباید در کامپایل نسخه کنسولی وارد شود. -->
  <ItemGroup>
    <Compile Remove="SmartParking.Dashboard\**" />
    <EmbeddedResource Remove="SmartParking.Dashboard\**" />
    <None Remove="SmartParking.Dashboard\**" />
  </ItemGroup>

</Project>